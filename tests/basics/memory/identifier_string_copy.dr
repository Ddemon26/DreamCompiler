}
class Reader {
    static func void readStatic(string staticInput) {
        string staticText = staticInput;
        Console.WriteLine(staticText);
    }
    func void readInstance(string instanceInput) {
        string instanceText = instanceInput;
        Console.WriteLine(instanceText);
    }
}
func void readOwned() {
    string backing = "owned" + " value";
    {
        string snapshot = backing;
        Console.WriteLine(snapshot);
