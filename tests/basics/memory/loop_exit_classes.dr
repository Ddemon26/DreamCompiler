class ExitToken {
    int value;
    func init(int value) { this.value = value; }
}
func void runClasses() {
    ExitToken survivor = new ExitToken(9);
    int i = 0;
    while (i < 3) {
        i++;
        ExitToken whileBody = new ExitToken(i);
        string text = "text";
        {
            ExitToken deep = new ExitToken(i);
            if (i == 1) continue;
            if (i == 3) break;
            Console.WriteLine(deep.value);
        }
        ExitToken late = new ExitToken(4);
    }
    Console.WriteLine(survivor.value);
    int d = 0;
    do {
        ExitToken doBody = new ExitToken(d);
        d++;
        if (d == 1) continue;
        break;
    } while (d < 3);
    int f = 0;
    for (string header = "header"; f < 3; f = f) {
        ExitToken forBody = new ExitToken(f);
        f++;
        switch (f) {
            case 1:
                ExitToken switchContinue = new ExitToken(1);
                continue;
            case 3:
                ExitToken switchBreak = new ExitToken(2);
                break;
            default:
                ExitToken switchNormal = new ExitToken(3);
                Console.WriteLine(switchNormal.value);
        }
        Console.WriteLine(forBody.value);
        Console.WriteLine(header);
        if (f == 3) break;
    }
    while (true) {
        ExitToken outerBody = new ExitToken(7);
        int j = 0;
        for (string innerHeader = "inner"; j < 2; j++) {
            ExitToken innerBody = new ExitToken(j);
            if (j == 0) continue;
            break;
        }
        Console.WriteLine(outerBody.value);
        break;
    }
    switch (1) {
        case 1:
            ExitToken caseOwner = new ExitToken(8);
            while (true) {
                ExitToken loopInSwitch = new ExitToken(0);
                break;
            }
            Console.WriteLine(caseOwner.value);
            break;
    }
}
class ExitMethods {
    static func void runStatic() {
        int i = 0;
        for (i = 0; i < 2; i++) {
            ExitToken staticToken = new ExitToken(10);
            if (i == 0) continue;
            Console.WriteLine(staticToken.value);
        }
    }
    func void runInstance() {
        do {
            ExitToken instanceToken = new ExitToken(11);
            Console.WriteLine(instanceToken.value);
            break;
        } while (true);
    }
}
func void runMethods() {
    ExitMethods.runStatic();
    ExitMethods reader = new ExitMethods();
    reader.runInstance();
}
runClasses();
runMethods();
int topIndex = 0;
for (string topHeader = "top"; topIndex < 2; topIndex++) {
    ExitToken topBody = new ExitToken(12);
