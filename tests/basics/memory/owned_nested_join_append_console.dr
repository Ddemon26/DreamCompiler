// Expected: newnewinner-B
// Expected: newnewinner-B
// Expected: A+outer-inner-BA+outer-inner-B
// Expected: 2
// Expected: A+outer-inner-BA+outer-inner-B
// Expected: A+outer-inner-BA+outer-inner-B

func string owned() {
    string result = "B";
    return result;
}

func string joined() {
    string inner = "inner-";
    return (inner += owned());
}

func string nested(string source, int effect) {
    string outer = source;
    return (outer += joined());
}

func string borrowed(string source) { return source; }

func void exercise() {
    int count = 0;
    string changed = "old";
    if (true) Console.WriteLine(changed += nested((changed = "new"), count++));
    Console.WriteLine(changed);

    string text = "A+";
    Console.Write(text += nested("outer-", count++));
    Console.WriteLine(text);
    Console.WriteLine(count);

    Console.WriteLine(text += borrowed(text));
    Console.WriteLine(text);
}

exercise();
