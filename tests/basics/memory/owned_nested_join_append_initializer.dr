// Expected: A+outer-inner-B
// Expected: A+outer-inner-B!
// Expected: newnewinner-B
// Expected: 1
// Expected: newnewinner-B
// Expected: samesame
// Expected: samesameouter-inner-B

func string owned() {
    string result = "B";
    return result;
}

func string joined(string source) {
    string result = source;
    return (result += owned());
}

func string nested(string source, int effect) {
    string outer = source;
    return (outer += joined("inner-"));
}

func string borrowed(string source) { return source; }

func void exercise() {
    for (int i = 0; i < 10000; i++) {
        string text = "A+";
        {
            string snapshot = (text += nested("outer-", 0));
            text += "!";
            if (i == 9999) Console.WriteLine(snapshot);
        }
        if (i == 9999) Console.WriteLine(text);
    }

    string changed = "old";
    int count = 0;
    {
        const string snapshot = (changed += nested((changed = "new"), count++));
        Console.WriteLine(snapshot);
        Console.WriteLine(count);
    }
    Console.WriteLine(changed);

    string alias = "same";
    string borrowedCopy = (alias += borrowed(alias));
    for (string header = (alias += nested("outer-", 0)); false; ) {
        Console.WriteLine("unexpected");
    }
    Console.WriteLine(borrowedCopy);
    Console.WriteLine(alias);
}

exercise();
