func void identityProbe() { factory(); }
func int joinDiscardProbe() {
    int count = 0;
    (joined(count++));
    return count;
}
func int nestedJoinDiscardProbe() {
    int count = 0;
    (nested(count++));
    return count;
}
func int tripleJoinDiscardProbe() {
    int count = 0;
    (deeper(count++));
    return count;
}
func int fourthJoinDiscardProbe() {
    int count = 0;
    (fourth(count++));
    return count;
}
func string factory() { string result = "owned"; return result; }
func string joined(int value) { string result = "start"; return (result += factory()); }
func string nested(int value) { string result = "outer-"; return (result += joined(value)); }
func string deeper(int value) { string result = "third-"; return (result += nested(value)); }
func string fourth(int value) { string result = "fourth-"; return (result += deeper(value)); }
func string clone(string source) { const string result = source; return result; }
func string empty() { string result = ""; return result; }
func string escaped() { const string result = "escaped \"value\""; return result; }
func string absent() { string result; return result; }
func string effect(int value) { string result = "effect"; return result; }
func string borrow(string source) { return source; }
func string literal() { return "literal"; }

func void early(bool stop) {
    factory();
    if (stop) return;
    factory();
}

func void exercise() {
    string backing = "backing";
    string snapshot = backing;
    clone(backing);
    borrow(backing);
    literal();
    clone(backing = "changed");
    Console.WriteLine(snapshot);
    Console.WriteLine(backing);
    (empty());
    escaped();
    absent();
    string missing;
    clone(missing);
    int count = 0;
    effect(count++);
    Console.WriteLine(count);
    if (true) factory();
    if (false) factory();
    for (int i = 0; i < 0; i++) factory();
    for (int i = 0; i < 4; i++) {
        factory();
        if (i == 0) continue;
        if (i == 2) break;
    }
    switch (count) {
        case 1: factory(); break;
        default: break;
    }
    { factory(); }
}

factory();
early(true);
exercise();
Console.WriteLine(joinDiscardProbe());
