// Expected: newnewouter-inner-B
// Expected: newnewouter-inner-B!
// Expected: A+third-outer-inner-BA+third-outer-inner-B
// Expected: 2
// Expected: samesame
// Expected: samesame

func string owned() {
    string result = "B";
    return result;
}

func string joined() {
    string inner = "inner-";
    return (inner += owned());
}

func string nested() {
    string outer = "outer-";
    return (outer += joined());
}

func string extended(string source, int effect) {
    string third = source;
    return (third += nested());
}

func string borrowed(string source) { return source; }

func void exercise() {
    int count = 0;
    string changed = "old";
    if (true) Console.WriteLine(changed += extended((changed = "new"), count++));
    changed += "!";
    Console.WriteLine(changed);

    string text = "A+";
    Console.Write(text += extended("third-", count++));
    Console.WriteLine(text);
    Console.WriteLine(count);

    string alias = "same";
    Console.WriteLine(alias += borrowed(alias));
    Console.WriteLine(alias);
}

exercise();
