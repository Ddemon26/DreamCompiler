        string doText = "do";
        return doText;
    } while (true);
}
// Active exception exits remain emission-only controls. The unused borrowed
// result checks P0041; literal/owned conditional results check P0038/P0040.
func string pendingResult() {
    string pendingOuter = "outer";
    try { string pendingTry = "try"; return pendingTry; }
    catch { string pendingCatch = "catch"; return pendingCatch; }
    finally { string pendingFinally = "finally"; return pendingFinally; }
    return pendingOuter;
}
func string borrowedResult(string source) {
    string borrowedDiscard = "discard";
