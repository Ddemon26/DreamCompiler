    return fallback;
}
func string switchResult(int choice) {
    string switchText = "switch";
    switch (choice) {
        case 1:
            string caseText = "case";
            ReturnToken caseOwner = new ReturnToken();
            return caseText;
        default: break;
    }
    return switchText;
}
func string nullResult() {
