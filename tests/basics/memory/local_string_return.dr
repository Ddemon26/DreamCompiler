        ReturnToken instanceOwner = new ReturnToken();
        return instanceResult;
    }
}
func string recursiveResult(int depth, string source) {
    string recursiveText = source;
    ReturnToken recursiveOwner = new ReturnToken();
    if (depth > 0) {
        string deeper = recursiveResult(depth - 1, recursiveText);
        return deeper;
    }
    return recursiveText;
}
func string collisionResult(string source) {
