class ReturnToken { }
func string nestedResult(bool stop, string source, string *pointer) {
    ReturnToken outerOwner = new ReturnToken();
    string first = source;
    string absent;
    const string empty = "";
    {
        const string selected = source;
        ReturnToken innerOwner = new ReturnToken();
        if (stop) return (selected);
        ReturnToken lateOwner = new ReturnToken();
    }
    return first;
}
func string loopResult(bool stop) {
    ReturnToken loopOwner = new ReturnToken();
    string fallback = "fallback";
    int i = 0;
    for (string header = "header"; i < 2; i++) {
        string loopText = "loop";
        ReturnToken bodyOwner = new ReturnToken();
        if (stop) return loopText;
