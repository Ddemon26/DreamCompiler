}
func string literalResult() {
    string literalDiscard = "discard";
    return "literal";
}
func string conditionalResult(bool choice) {
    string left = "left";
    string right = "right";
    return choice ? left : right;
}
func void exercise() {
    string backing = "backing" + " value";
    string values[1];
    values[0] = backing;
    string snapshot = nestedResult(true, backing, values);
    Console.WriteLine(snapshot);
    Console.WriteLine(nestedResult(false, backing, values));
    Console.WriteLine(loopResult(true));
    Console.WriteLine(loopResult(false));
    Console.WriteLine(switchResult(1));
    Console.WriteLine(switchResult(2));
    string absentCopy = nullResult();
    if (absentCopy == null) Console.WriteLine("null");
    Console.Write(emptyResult());
    Console.WriteLine("empty");
    Console.WriteLine(replacedResult(backing));
    Console.WriteLine(ReturnReader.readStatic());
    ReturnReader reader = new ReturnReader();
    Console.WriteLine(reader.readInstance(backing));
    Console.WriteLine(recursiveResult(1, backing));
    Console.WriteLine(collisionResult(backing));
    Console.WriteLine(completedResult());
    Console.WriteLine(zeroResult());
    Console.WriteLine(whileResult());
    Console.WriteLine(doResult());
    Console.WriteLine(reader.label);
    Console.WriteLine(backing);
    backing = "changed";
    Console.WriteLine(snapshot);
    Console.WriteLine(backing);
}
exercise();
