func string factory() { string result = "owned"; return result; }
func string joined(int value) { string result = "start"; return (result += factory()); }
func string nested(int value) { string result = "outer-"; return (result += joined(value)); }
func string clone(string source) { string result = source; return result; }
func string effect(int value) { string result = "effect"; return result; }
func void view(string source) { Console.Write(source); }
func void bare(string source) { Console.Write(source); }
func void line(string source) { Console.WriteLine(source); }

func void identityProbe() {
    view(factory());
    Console.Write(factory());
    Console.WriteLine(factory());
}
func int joinOutputProbe() {
    int count = 0;
    if (true) Console.Write(joined(count++));
    Console.WriteLine(joined(count++));
    if (true) view(joined(count++));
    line(joined(count++));
    return count;
}
func int nestedOutputProbe() {
    int count = 0;
    if (true) Console.Write(nested(count++));
    Console.WriteLine(nested(count++));
    if (true) view(nested(count++));
    line(nested(count++));
    return count;
}
func void exercise() {
    string dreamOwnedArgument0 = "snapshot";
    int count = 0;
    if (true) line(clone(dreamOwnedArgument0));
    if (false) line(factory());
    { line(effect(count++)); }
    Console.WriteLine(count);
    line(factory());
    bare(factory());
    Console.WriteLine("");
    if (true) Console.Write(effect(count++));
    Console.WriteLine(factory());
    Console.WriteLine(count);
}

exercise();
Console.WriteLine(joinOutputProbe());
Console.WriteLine(nestedOutputProbe());
