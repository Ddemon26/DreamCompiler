// Expected: AB
// Expected: AB!
// Expected: newnew
// Expected: 1
// Expected: []
// Expected: samesame
// Expected: samesameB

func string factory() {
    string result = "B";
    return result;
}

func string clone(string source, int effect) {
    string result = source;
    return result;
}

func string absent() {
    string result;
    return result;
}

func string borrowed(string source) { return source; }

func void exercise() {
    for (int i = 0; i < 10000; i++) {
        string text = "A";
        {
            string snapshot = (text += factory());
            text += "!";
            if (i == 9999) Console.WriteLine(snapshot);
        }
        if (i == 9999) Console.WriteLine(text);
    }

    string changed = "old";
    int count = 0;
    const string postAssignment = (changed += clone((changed = "new"), count++));
    Console.WriteLine(postAssignment);
    Console.WriteLine(count);

    string empty;
    string emptyCopy = (empty += absent());
    if (empty != null && emptyCopy != null) {
        Console.Write("[");
        Console.Write(emptyCopy);
        Console.WriteLine("]");
    }

    string alias = "same";
    string borrowedCopy = (alias += borrowed(alias));
    for (string header = (alias += factory()); false; ) {
        Console.WriteLine("unexpected");
    }
    Console.WriteLine(borrowedCopy);
    Console.WriteLine(alias);
}

exercise();
