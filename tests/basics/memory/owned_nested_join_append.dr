// Expected: A+outer-inner-B
// Expected: newnewinner-B
// Expected: 1
// Expected: newnewinner-Bnewnewinner-B

func string owned() {
    string result = "B";
    return result;
}

func string joined(string source) {
    string result = source;
    return (result += owned());
}

func string nested(string source, int effect) {
    string outer = source;
    return (outer += joined("inner-"));
}

func string borrowed(string source) { return source; }

func void exercise() {
    for (int i = 0; i < 10000; i++) {
        string text = "A+";
        text += nested("outer-", 0);
        if (i == 9999) Console.WriteLine(text);
    }

    string changed = "old";
    int count = 0;
    if (true) changed += nested((changed = "new"), count++);
    Console.WriteLine(changed);
    Console.WriteLine(count);

    changed += borrowed(changed);
    Console.WriteLine(changed);
}

exercise();
