func string loopBorrowed(bool stop, string source) {
    string outerText = "outer";
    int i = 0;
    for (string header = "header"; i < 2; header += "x") {
        BorrowedReturnToken bodyOwner = new BorrowedReturnToken();
        string bodyText = header;
        if (stop) return source;
        i++;
