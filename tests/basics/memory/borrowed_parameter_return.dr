func string noBorrowedLocals(string source) { return source; }
// Emission-only controls: rebinding anywhere, including loop updates or a
// nested expression, disqualifies this parameter even at an earlier return.
func string reboundBorrowed(bool stop, string source) {
    string reboundText = "owned";
    if (stop) return source;
    source = reboundText;
    return source;
}
func string updatedBorrowed(bool stop, string source) {
    for (string updateText = "owned"; true; source = updateText)
        if (stop) return source;
    return source;
}
func string expressionBorrowed(bool stop, string source) {
    string expressionText = "owned";
    if (stop) return source;
    Console.WriteLine(source = expressionText);
    return source;
}
func string pendingBorrowed(string source) {
    string pendingOuter = "discard";
    try { string pendingTry = "try"; return source; }
    catch { string pendingCatch = "catch"; return source; }
    finally { string pendingFinally = "finally"; return source; }
    return source;
}
func string conditionalBorrowed(bool choice, string source) {
    string conditionalText = "discard";
    return choice ? source : "literal";
}
func void exerciseBorrowed() {
    string backing = "backing";
    string values[1];
    values[0] = backing;
    string snapshot = nestedBorrowed(true, backing, values);
    Console.WriteLine(snapshot);
    Console.WriteLine(nestedBorrowed(false, backing, values));
    Console.WriteLine(nestedBorrowed(true, "literal", values));
    Console.WriteLine(nestedBorrowed(true, "", values));
    string absent;
    if (nestedBorrowed(true, absent, values) == null) Console.WriteLine("null");
    Console.WriteLine(loopBorrowed(true, backing));
    Console.WriteLine(loopBorrowed(false, backing));
    Console.WriteLine(switchBorrowed(backing));
    Console.WriteLine(BorrowedReturnReader.readStatic(backing));
    BorrowedReturnReader reader = new BorrowedReturnReader();
    Console.WriteLine(reader.readInstance(backing));
    Console.WriteLine(recursiveBorrowed(2, backing));
    Console.WriteLine(completedBorrowed(backing));
    Console.WriteLine(collisionBorrowed(backing));
    Console.WriteLine(otherWrite(backing, "other"));
    Console.WriteLine(noBorrowedLocals(backing));
    backing = "changed";
    Console.WriteLine(snapshot);
    Console.WriteLine(backing);
}
exerciseBorrowed();
