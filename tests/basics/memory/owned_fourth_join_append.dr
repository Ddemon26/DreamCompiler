// Expected: A+fourth-third-outer-inner-B
// Expected: newnewthird-outer-inner-B
// Expected: 1
// Expected: newnewthird-outer-inner-Bnewnewthird-outer-inner-B

func string owned() {
    string result = "B";
    return result;
}

func string joined() {
    string inner = "inner-";
    return (inner += owned());
}

func string nested() {
    string outer = "outer-";
    return (outer += joined());
}

func string extended() {
    string third = "third-";
    return (third += nested());
}

func string fourth(string source, int effect) {
    string last = source;
    return (last += extended());
}

func string fifth() {
    string last = "fifth-";
    return (last += fourth("fourth-", 0));
}

func string borrowed(string source) { return source; }

func void exercise() {
    for (int i = 0; i < 10000; i++) {
        string text = "A+";
        text += fourth("fourth-", 0);
        if (i == 9999) Console.WriteLine(text);
    }

    string changed = "old";
    int count = 0;
    if (true) changed += fourth((changed = "new"), count++);
    Console.WriteLine(changed);
    Console.WriteLine(count);

    if (false) changed += fifth();
    changed += borrowed(changed);
    Console.WriteLine(changed);
}

exercise();
