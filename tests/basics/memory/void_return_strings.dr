}
func void whileExit(string source) {
    string whileOuter = source;
    int i = 0;
    while (i < 3) {
        string whileBody = source;
        i++;
        if (i == 2) return;
        continue;
    }
}
func void doExit(string source) {
    string doOuter = source;
    do {
