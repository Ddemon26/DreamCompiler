}
func void exercise() {
    string backing = "backing" + " value";
    string values[1];
    values[0] = backing;
    nested(backing, values, true);
    nested(backing, values, false);
    whileExit(backing);
    doExit(backing);
    forExit(backing, true);
    forExit(backing, false);
    switchExit(backing, 1);
    switchExit(backing, 2);
    zeroExit(backing);
    recurse(backing, 2);
    borrowedOnly(backing, values);
    noLocals();
    ReturnReader.runStatic(backing);
    ReturnReader reader = new ReturnReader();
    reader.runInstance(backing);
    completedException(backing);
    Console.WriteLine(backing);
}
exercise();
