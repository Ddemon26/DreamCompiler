// These unused paths retain existing exception-return emission; unwinding is
// intentionally outside this pass. The Go matrix checks this boundary.
func void pendingException(string source) {
    string pendingOuter = source;
    try {
        string pendingTry = source;
        return;
    } catch {
        string pendingCatch = source;
        return;
    } finally {
        string pendingFinally = source;
        return;
    }
}
func void completedException(string source) {
    string completedOuter = source;
    try {
