}
func void switchExit(string source, int choice) {
    string switchOuter = source;
    switch (choice) {
        case 1:
            string caseText = source;
            if (choice == 1) return;
            break;
        default:
            string normal = "normal";
            Console.WriteLine(normal);
    }
    string after = "after";
    Console.WriteLine(after);
}
func void zeroExit(string source) {
    string zeroOuter = source;
    for (string zeroHeader = source; false;) {
        string never = "never";
