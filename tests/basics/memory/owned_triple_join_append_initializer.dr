// Expected: A+third-outer-inner-B
// Expected: A+third-outer-inner-B!
// Expected: newnewouter-inner-B
// Expected: 1
// Expected: newnewouter-inner-B
// Expected: samesame
// Expected: samesamethird-outer-inner-B

func string owned() {
    string result = "B";
    return result;
}

func string joined() {
    string inner = "inner-";
    return (inner += owned());
}

func string nested() {
    string outer = "outer-";
    return (outer += joined());
}

func string extended(string source, int effect) {
    string third = source;
    return (third += nested());
}

func string borrowed(string source) { return source; }

func void exercise() {
    for (int i = 0; i < 10000; i++) {
        string text = "A+";
        {
            string snapshot = (text += extended("third-", 0));
            text += "!";
            if (i == 9999) Console.WriteLine(snapshot);
        }
        if (i == 9999) Console.WriteLine(text);
    }

    string changed = "old";
    int count = 0;
    {
        const string snapshot = (changed += extended((changed = "new"), count++));
        Console.WriteLine(snapshot);
        Console.WriteLine(count);
    }
    Console.WriteLine(changed);

    string alias = "same";
    string borrowedCopy = (alias += borrowed(alias));
    for (string header = (alias += extended("third-", 0)); false; ) {
        Console.WriteLine("unexpected");
    }
    Console.WriteLine(borrowedCopy);
    Console.WriteLine(alias);
}

exercise();
