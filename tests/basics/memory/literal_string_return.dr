class LiteralReturnToken { }
func string nestedLiteral(bool stop, string source, string *pointer) {
    LiteralReturnToken outerOwner = new LiteralReturnToken();
    string first = source;
    string absent;
    const string empty = "";
    {
        LiteralReturnToken innerOwner = new LiteralReturnToken();
        string innerText = "discard";
        if (stop) return ("early");
        string late = "late";
    }
    return "fall";
}
func string forLiteral(bool stop) {
    LiteralReturnToken forOwner = new LiteralReturnToken();
    int i = 0;
    for (string header = "header"; i < 2; header += "x") {
        string bodyText = "body";
        LiteralReturnToken bodyOwner = new LiteralReturnToken();
        if (stop) return "loop";
        i++;
    }
    return "after";
}
func string switchLiteral(int choice) {
    string switchText = "switch";
    switch (choice) {
        case 1:
            string caseText = "case";
            LiteralReturnToken caseOwner = new LiteralReturnToken();
            return "case";
        default: break;
    }
    return "";
}
func string whileLiteral() {
    LiteralReturnToken whileOwner = new LiteralReturnToken();
    int i = 0;
    while (i < 2) {
        string whileText = "while";
        if (i++ == 1) return "while";
    }
    return "unused";
}
func string doLiteral() {
    string doText = "do";
    do {
        LiteralReturnToken doOwner = new LiteralReturnToken();
        return "do";
    } while (true);
}
class LiteralReturnReader {
    string label;
    func init() { this.label = "reader"; }
    static func string readStatic() {
        string staticText = "discard";
        return "static";
    }
    func string readInstance() {
        LiteralReturnToken instanceOwner = new LiteralReturnToken();
        string instanceText = "discard";
        return "instance";
