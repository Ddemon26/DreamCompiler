}
func string escapedLiteral() {
    string escapedText = "discard";
    return "quoted \"value\"";
}
func string noLocals() { return "plain"; }
// Active exception exits and borrowed results remain emission-only controls.
// The unused all-literal conditional now checks P0039 cleanup emission.
func string pendingLiteral() {
    string pendingOuter = "discard";
    try { string pendingTry = "try"; return "try"; }
    catch { string pendingCatch = "catch"; return "catch"; }
    finally { string pendingFinally = "finally"; return "finally"; }
    return "done";
}
func string borrowedLiteral(string source) {
    string borrowedDiscard = "discard";
    return source;
}
func string compoundLiteral(bool choice) {
    string compoundDiscard = "discard";
    return choice ? "left" : "right";
}
func void exercise() {
    string backing = "backing";
    string values[1];
    values[0] = backing;
    string snapshot = nestedLiteral(true, backing, values);
    Console.WriteLine(snapshot);
    Console.WriteLine(nestedLiteral(false, backing, values));
    Console.WriteLine(forLiteral(true));
    Console.WriteLine(forLiteral(false));
    Console.WriteLine(switchLiteral(1));
    Console.WriteLine(switchLiteral(2));
    Console.WriteLine(whileLiteral());
    Console.WriteLine(doLiteral());
    Console.WriteLine(LiteralReturnReader.readStatic());
    LiteralReturnReader reader = new LiteralReturnReader();
    Console.WriteLine(reader.readInstance());
    Console.WriteLine(recursiveLiteral(2));
    Console.WriteLine(completedLiteral());
    Console.WriteLine(zeroLiteral());
    Console.WriteLine(collisionLiteral());
    Console.WriteLine(escapedLiteral());
    Console.WriteLine(noLocals());
    Console.WriteLine(reader.label);
    Console.WriteLine(backing);
    Console.WriteLine(snapshot);
}
exercise();
