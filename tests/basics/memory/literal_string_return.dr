}
func string recursiveLiteral(int depth) {
    string recursiveText = "discard";
    LiteralReturnToken recursiveOwner = new LiteralReturnToken();
    if (depth > 0) recursiveLiteral(depth - 1);
    return "recursive";
}
func string completedLiteral() {
    string completedText = "discard";
    try { string tryText = "try"; }
    catch { }
    finally { LiteralReturnToken finallyOwner = new LiteralReturnToken(); }
    return "completed";
}
func string zeroLiteral() {
    string zeroText = "discard";
    for (string zeroHeader = "header"; false;) {
        string neverText = "never";
        return "never";
