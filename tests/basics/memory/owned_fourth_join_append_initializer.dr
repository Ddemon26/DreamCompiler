// Expected: A+fourth-third-outer-inner-B
// Expected: A+fourth-third-outer-inner-B!
// Expected: newnewthird-outer-inner-B
// Expected: 1
// Expected: newnewthird-outer-inner-B
// Expected: samesame
// Expected: samesamefourth-third-outer-inner-B

func string owned() {
    string result = "B";
    return result;
}

func string joined() {
    string inner = "inner-";
    return (inner += owned());
}

func string nested() {
    string outer = "outer-";
    return (outer += joined());
}

func string extended() {
    string third = "third-";
    return (third += nested());
}

func string fourth(string source, int effect) {
    string last = source;
    return (last += extended());
}

func string fifth() {
    string last = "fifth-";
    return (last += fourth("fourth-", 0));
}

func string borrowed(string source) { return source; }

func void exercise() {
    for (int i = 0; i < 10000; i++) {
        string text = "A+";
        {
            string snapshot = (text += fourth("fourth-", 0));
            text += "!";
            if (i == 9999) Console.WriteLine(snapshot);
        }
        if (i == 9999) Console.WriteLine(text);
    }

    string changed = "old";
    int count = 0;
    {
        const string snapshot = (changed += fourth((changed = "new"), count++));
        Console.WriteLine(snapshot);
        Console.WriteLine(count);
    }
    Console.WriteLine(changed);

    if (false) {
        string beyond = (changed += fifth());
        Console.WriteLine(beyond);
    }

    string alias = "same";
    string borrowedCopy = (alias += borrowed(alias));
    for (string header = (alias += fourth("fourth-", 0)); false; ) {
        Console.WriteLine("unexpected");
    }
    Console.WriteLine(borrowedCopy);
    Console.WriteLine(alias);
}

exercise();
