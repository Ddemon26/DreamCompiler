// Expected: A+B
// Expected: newnew
// Expected: 1
// Expected: []
// Expected: B
// Expected: B BB B
// Expected: BB B

func string factory() {
    string result = "B";
    return result;
}

func string clone(string source, int effect) {
    string result = source;
    return result;
}

func string absent() {
    string result;
    return result;
}

func string borrowed(string source) { return source; }

func void exercise() {
    for (int i = 0; i < 10000; i++) {
        string text = "A+";
        text += factory();
        if (i == 9999) Console.WriteLine(text);
    }

    string dreamOwnedArgument0 = "B B";
    string changed = "old";
    int count = 0;
    if (true) changed += clone((changed = "new"), count++);
    Console.WriteLine(changed);
    Console.WriteLine(count);

    string empty;
    empty += absent();
    if (empty != null) {
        Console.Write("[");
        Console.Write(empty);
        Console.WriteLine("]");
    }

    string fromNull;
    fromNull += factory();
    Console.WriteLine(fromNull);
    fromNull += clone(dreamOwnedArgument0, 0);

    string alias = dreamOwnedArgument0;
    alias += borrowed(alias);
    Console.WriteLine(alias);
    Console.WriteLine(fromNull);
}

exercise();
